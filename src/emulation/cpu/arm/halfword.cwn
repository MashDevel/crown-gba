module cpu {
    module arm {
        struct HalfwordTransfer {
            load: bool
            kind: u32
            preindex: bool
            up: bool
            writeback: bool
            base_register: usize
            data_register: usize
            offset: u32
        }

        fn execute_halfword(emulator: write emulator::State, opcode: u32) -> u32 {
            let transfer = halfword_transfer(emulator.cpu, opcode)
            let base = cpu::read_register(emulator.cpu, transfer.base_register)
            var adjusted = base.wrapping_add(transfer.offset)
            if transfer.up == false {
                adjusted = base.wrapping_sub(transfer.offset)
            }
            var address = base
            if transfer.preindex {
                address = adjusted
            }
            if transfer.load {
                let value = load_halfword(emulator, transfer.kind, address)
                cpu::write_register(emulator.cpu, transfer.data_register, value)
            } else {
                let value = cpu::read_register(emulator.cpu, transfer.data_register)
                bus::write16(emulator, address, u16.from(value & 65535))
            }
            if transfer.preindex == false {
                cpu::write_register(emulator.cpu, transfer.base_register, adjusted)
            } else {
                if transfer.writeback {
                    cpu::write_register(emulator.cpu, transfer.base_register, adjusted)
                }
            }
            if transfer.load {
                return 3
            }
            return 2
        }

        fn halfword_transfer(cpu: cpu::State, opcode: u32) -> HalfwordTransfer {
            var offset = cpu::read_register(cpu, usize.from(opcode & encoding::REGISTER_MASK))
            if bits::bit_u32(opcode, encoding::IMMEDIATE_HALFWORD) {
                offset = (opcode >> encoding::MULTIPLIER_SHIFT & encoding::REGISTER_MASK) << 4 | opcode & encoding::REGISTER_MASK
            }
            return HalfwordTransfer {
                load: bits::bit_u32(opcode, encoding::LOAD)
                kind: opcode >> 5 & 3
                preindex: bits::bit_u32(opcode, encoding::PREINDEX)
                up: bits::bit_u32(opcode, encoding::UP)
                writeback: bits::bit_u32(opcode, encoding::WRITEBACK)
                base_register: usize.from(opcode >> encoding::BASE_SHIFT & encoding::REGISTER_MASK)
                data_register: usize.from(opcode >> encoding::DESTINATION_SHIFT & encoding::REGISTER_MASK)
                offset: offset
            }
        }

        fn load_halfword(emulator: write emulator::State, kind: u32, address: u32) -> u32 {
            if kind == 1 {
                let value = bus::read16(emulator, address & memory::HALFWORD_ADDRESS_MASK)
                return bits::rotate_right_u32(u32.from(value), (address & 1) * 8)
            }
            if kind == 2 {
                let byte = bus::read8(emulator, address)
                return u32.from_bits(i32.from(i8.from_bits(byte)))
            }
            if address & 1 != 0 {
                let byte = bus::read8(emulator, address)
                return u32.from_bits(i32.from(i8.from_bits(byte)))
            }
            let half = bus::read16(emulator, address)
            return u32.from_bits(i32.from(i16.from_bits(half)))
        }
    }
}
