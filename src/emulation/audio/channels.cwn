module audio {
    struct ChannelControl {
        enabled: bool
        dac_enabled: bool
        length: u16
        length_enabled: bool
    }

    struct Envelope {
        volume: u8
        period: u8
        timer: u8
        increase: bool
    }

    fn new_channel_control() -> ChannelControl {
        return ChannelControl {
            enabled: false
            dac_enabled: false
            length: 0
            length_enabled: false
        }
    }

    fn new_envelope() -> Envelope {
        return Envelope {
            volume: 0, period: 0, timer: 0, increase: false
        }
    }

    fn channel_set_dac(control: write ChannelControl, enabled: bool) -> void {
        control.dac_enabled = enabled
        if enabled == false {
            control.enabled = false
        }
        return
    }

    fn channel_trigger(control: write ChannelControl, default_length: u16) -> void {
        control.enabled = control.dac_enabled
        if control.length == 0 {
            control.length = default_length
        }
        return
    }

    fn channel_length_tick(control: write ChannelControl) -> void {
        if control.enabled == false || control.length_enabled == false || control.length == 0 {
            return
        }
        control.length = control.length - 1
        if control.length == 0 {
            control.enabled = false
        }
    }

    fn channel_active(control: ChannelControl) -> bool {
        if control.enabled == false {
            return false
        }
        return control.dac_enabled
    }

    fn envelope_set(envelope: write Envelope, value: u16) -> void {
        envelope.volume = u8.from(value >> ENVELOPE_VOLUME_SHIFT & 15)
        envelope.increase = value & ENVELOPE_INCREASE != 0
        envelope.period = u8.from(value >> ENVELOPE_PERIOD_SHIFT & 7)
        return
    }

    fn envelope_trigger(envelope: write Envelope) -> void {
        envelope.timer = envelope.period
        if envelope.timer == 0 {
            envelope.timer = 1
        }
        return
    }

    fn envelope_tick(envelope: write Envelope, enabled: bool) -> void {
        if enabled == false {
            return
        }
        if envelope.period == 0 {
            return
        }
        if envelope.timer != 0 {
            envelope.timer = envelope.timer - 1
        }
        if envelope.timer != 0 {
            return
        }
        envelope.timer = envelope.period
        if envelope.increase {
            if envelope.volume < 15 {
                envelope.volume = envelope.volume + 1
            }
        } else {
            if envelope.volume > 0 {
                envelope.volume = envelope.volume - 1
            }
        }
        return
    }
}
