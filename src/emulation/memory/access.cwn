module memory {
    fn io_read16(memory: State, offset: usize) -> u16 {
        let index = offset & IO_MASK
        return bytes::join_u16(memory.io[index], memory.io[(index + 1) & IO_MASK])
    }

    fn io_read8(memory: State, offset: usize) -> u8 {
        if offset >= timers::BASE {
            if offset < timers::END {
                let register = offset - timers::BASE
                let byte = register % timers::STRIDE
                let counter = memory.timer_counter[register / timers::STRIDE]
                if byte == 0 {
                    return u8.from(counter & 255)
                }
                if byte == 1 {
                    return u8.from(counter >> 8)
                }
            }
        }
        return memory.io[offset & IO_MASK]
    }

    fn io_read32(memory: State, offset: usize) -> u32 {
        loan read memory.io as bytes {
            return std::bytes::read_u32_le(bytes, offset)
        }
    }

    fn io_store16(memory: write State, offset: usize, value: u16) -> void {
        memory.io[offset] = u8.from(value & 255)
        memory.io[(offset + 1) % IO_SIZE] = u8.from(value >> 8)
        if offset == system::WAIT_CONTROL {
            bus::memory_update_waitstates(memory, value)
        }
        video::update_affine_reference(memory, offset)
        return
    }

    fn io_store32(memory: write State, offset: usize, value: u32) -> void {
        io_store16(memory, offset, u16.from(value & 65535))
        io_store16(memory, offset + 2, u16.from(value >> 16))
        return
    }

    fn vram_index(address: u32) -> usize {
        var index = usize.from(address - memory::VRAM_START) % VRAM_WINDOW_SIZE
        if index >= VRAM_SIZE {
            index = index - VRAM_MIRROR_SIZE
        }
        return index
    }

    fn read8(memory: State, cartridge: cartridge::Image, address: u32) -> u8 {
        let region = address >> memory::REGION_SHIFT
        if region == memory::region::BIOS {
            return memory.bios[usize.from(address) % BIOS_SIZE]
        }
        if region == memory::region::EWRAM {
            return memory.ewram[usize.from(address) % EWRAM_SIZE]
        }
        if region == memory::region::IWRAM {
            return memory.iwram[usize.from(address) % IWRAM_SIZE]
        }
        if region == memory::region::IO {
            return io_read8(memory, usize.from(address) % IO_SIZE)
        }
        if region == memory::region::PALETTE {
            return memory.palette[usize.from(address) % IO_SIZE]
        }
        if region == memory::region::VRAM {
            return memory.vram[vram_index(address)]
        }
        if region == memory::region::OAM {
            return memory.oam[usize.from(address) % IO_SIZE]
        }
        if region_is_rom(region) {
            return cartridge::read8(cartridge, address)
        }
        if region == memory::region::SAVE {
            return backup::read8(memory, address)
        }
        return 0
    }

    fn read16(memory: State, cartridge: cartridge::Image, address: u32) -> u16 {
        let aligned = address & memory::HALFWORD_ADDRESS_MASK
        let region = aligned >> memory::REGION_SHIFT
        if region == memory::region::BIOS {
            return vector_read16(memory.bios, usize.from(aligned) % BIOS_SIZE)
        }
        if region == memory::region::EWRAM {
            return vector_read16(memory.ewram, usize.from(aligned) % EWRAM_SIZE)
        }
        if region == memory::region::IWRAM {
            return vector_read16(memory.iwram, usize.from(aligned) % IWRAM_SIZE)
        }
        if region == memory::region::PALETTE {
            return vector_read16(memory.palette, usize.from(aligned) % IO_SIZE)
        }
        if region == memory::region::VRAM {
            return vector_read16(memory.vram, vram_index(aligned))
        }
        if region == memory::region::OAM {
            return vector_read16(memory.oam, usize.from(aligned) % IO_SIZE)
        }
        if region_is_rom(region) {
            return cartridge::read16(cartridge, aligned)
        }
        return bytes::join_u16(
            read8(memory, cartridge, aligned),
            read8(memory, cartridge, aligned.wrapping_add(1))
        )
    }

    fn read32(memory: State, cartridge: cartridge::Image, address: u32) -> u32 {
        let aligned = address & memory::WORD_ADDRESS_MASK
        let region = aligned >> memory::REGION_SHIFT
        if region == memory::region::BIOS {
            return vector_read32(memory.bios, usize.from(aligned) % BIOS_SIZE)
        }
        if region == memory::region::EWRAM {
            return vector_read32(memory.ewram, usize.from(aligned) % EWRAM_SIZE)
        }
        if region == memory::region::IWRAM {
            return vector_read32(memory.iwram, usize.from(aligned) % IWRAM_SIZE)
        }
        if region == memory::region::PALETTE {
            return vector_read32(memory.palette, usize.from(aligned) % IO_SIZE)
        }
        if region == memory::region::VRAM {
            return vector_read32(memory.vram, vram_index(aligned))
        }
        if region == memory::region::OAM {
            return vector_read32(memory.oam, usize.from(aligned) % IO_SIZE)
        }
        if region_is_rom(region) {
            return cartridge::read32(cartridge, aligned)
        }
        let first = read8(memory, cartridge, aligned)
        let second = read8(memory, cartridge, aligned.wrapping_add(1))
        let third = read8(memory, cartridge, aligned.wrapping_add(2))
        let high = read8(memory, cartridge, aligned.wrapping_add(3))
        let bytes = [first, second, third, high]
        loan read bytes as source {
            return std::bytes::read_u32_le(source, 0)
        }
    }

    fn vector_read16(values: Vec<u8>, index: usize) -> u16 {
        if index >= values.length() || values.length() - index < 2 {
            return 0
        }
        return bytes::join_u16(values[index], values[index + 1])
    }

    fn vector_read32(values: Vec<u8>, index: usize) -> u32 {
        if index >= values.length() || values.length() - index < 4 {
            return 0
        }
        loan read values as bytes {
            return std::bytes::read_u32_le(bytes, index)
        }
    }

    fn write8(memory: write State, address: u32, value: u8) -> void {
        let region = address >> memory::REGION_SHIFT
        if region == memory::region::EWRAM {
            memory.ewram[usize.from(address) % EWRAM_SIZE] = value
        }
        if region == memory::region::IWRAM {
            memory.iwram[usize.from(address) % IWRAM_SIZE] = value
        }
        if region == memory::region::IO {
            write_io8(memory, usize.from(address) % IO_SIZE, value);
            return
        }
        if region == memory::region::PALETTE {
            let index = usize.from(address & memory::HALFWORD_ADDRESS_MASK) % 1024
            memory.palette[index] = value
            memory.palette[index + 1] = value
            update_palette(memory, index)
        }
        if region == memory::region::VRAM {
            let aligned = address & memory::HALFWORD_ADDRESS_MASK
            let index = vram_index(aligned)
            memory.vram[index] = value
            memory.vram[index + 1] = value
        }
        if region == memory::region::SAVE {
            backup::write8(memory, address, value)
        }
        return
    }

    fn write16(memory: write State, address: u32, value: u16) -> void {
        let aligned = address & memory::HALFWORD_ADDRESS_MASK
        let region = aligned >> memory::REGION_SHIFT
        if memory.save_kind == backup::Kind::Eeprom() {
            if address >> memory::REGION_SHIFT == memory::region::ROM_LAST {
                backup::eeprom_write_bit(memory, u8.from(value & 1))
                return
            }
        }
        if region == memory::region::IO {
            if write_io16(memory, aligned, value) {
                return
            }
        }
        write_region16(memory, aligned, value)
        return
    }

    fn write_io16(memory: write State, address: u32, value: u16) -> bool {
        if video::write16(memory, usize.from(address) % IO_SIZE, value) {
            return true
        }
        if address == memory::io_address(keypad::INPUT) {
            return true
        }
        if address == memory::io_address(keypad::CONTROL) {
            keypad::write_control(memory, value)
            return true
        }

        if address >= memory::io_address(audio::PULSE1_SWEEP) {
            if address <= memory::io_address(audio::REGISTER_END - 2) {
                let offset = usize.from(address - memory::IO_START)
                io_store16(memory, offset, value)
                memory.audio_events.push(audio_event(2, offset, u32.from(value)))
                return true
            }
        }

        if address >= memory::io_address(timers::BASE) {
            if address <= memory::io_address(timers::END - 2) {
                timers::timer_write_register(memory, address, value)
                return true
            }
        }
        return write_system16(memory, address, value)
    }

    fn write_region16(memory: write State, address: u32, value: u16) -> void {
        let region = address >> memory::REGION_SHIFT
        if region == memory::region::PALETTE {
            let index = usize.from(address) % IO_SIZE
            memory.palette[index] = u8.from(value & 255)
            memory.palette[index + 1] = u8.from(value >> 8)
            update_palette(memory, index)
            return
        }
        if region == memory::region::VRAM {
            let index = vram_index(address)
            memory.vram[index] = u8.from(value & 255)
            memory.vram[index + 1] = u8.from(value >> 8)
            return
        }
        if region == memory::region::OAM {
            let index = usize.from(address) % IO_SIZE
            memory.oam[index] = u8.from(value & 255)
            memory.oam[index + 1] = u8.from(value >> 8)
            return
        }
        write8(memory, address, u8.from(value & 255))
        write8(memory, address.wrapping_add(1), u8.from(value >> 8))
        return
    }

    fn update_palette(memory: write State, index: usize) -> void {
        let raw = vector_read16(memory.palette, index)
        memory.palette_colors[index / 2] = video::bgr555_color(raw)
        return
    }

    fn write_system8(memory: write State, offset: usize, value: u8) -> void {
        let aligned = offset & 1022
        let current = io_read16(memory, aligned)
        var combined = current & 65280 | u16.from(value)
        if offset & 1 != 0 {
            combined = current & 255 | u16.from(value) << 8
        }
        write16(memory, memory::IO_START + u32.from(aligned), combined)
        return
    }

    fn write32(memory: write State, address: u32, value: u32) -> void {
        let aligned = address & memory::WORD_ADDRESS_MASK
        if aligned == memory::io_address(system::INTERRUPT_ENABLE) {
            write16(memory, aligned, u16.from(value & 65535))
            write16(memory, aligned.wrapping_add(2), u16.from(value >> 16))
            return
        }
        if aligned == memory::io_address(keypad::INPUT) {
            keypad::write_control(memory, u16.from(value >> 16))
            return
        }
        if aligned >= memory::io_address(audio::PULSE1_SWEEP) {
            if aligned <= memory::io_address(audio::FIFO_B) {
                let offset = usize.from(aligned - memory::IO_START)
                io_store32(memory, offset, value)
                memory.audio_events.push(audio_event(4, offset, value))
                return
            }
        }
        let region = aligned >> memory::REGION_SHIFT
        if region == memory::region::PALETTE {
            write16(memory, aligned, u16.from(value & 65535))
            write16(memory, aligned.wrapping_add(2), u16.from(value >> 16))
            return
        }
        if region == memory::region::VRAM {
            write16(memory, aligned, u16.from(value & 65535))
            write16(memory, aligned.wrapping_add(2), u16.from(value >> 16))
            return
        }
        if region == memory::region::OAM {
            write16(memory, aligned, u16.from(value & 65535))
            write16(memory, aligned.wrapping_add(2), u16.from(value >> 16))
            return
        }
        write8(memory, aligned, bytes::low_u8(value))
        write8(memory, aligned.wrapping_add(1), bytes::high_u8(value, 8))
        write8(memory, aligned.wrapping_add(2), bytes::high_u8(value, 16))
        write8(memory, aligned.wrapping_add(3), bytes::high_u8(value, 24))
        return
    }

    fn audio_event(width: usize, offset: usize, value: u32) -> audio::RegisterWrite {
        return audio::RegisterWrite {
            width: u8.from(width), offset: u16.from(offset), value: value
        }
    }

    fn region_is_rom(region: u32) -> bool {
        region >= memory::region::ROM_FIRST && region <= memory::region::ROM_LAST
    }

    fn write_io8(memory: write State, offset: usize, value: u8) -> void {
        if video::write8(memory, offset, value) {
            return
        }
        if offset >= keypad::INPUT && offset <= keypad::CONTROL + 1 {
            write_keypad8(memory, offset, value);
            return
        }
        if system_offset(offset) {
            write_system8(memory, offset, value);
            return
        }
        memory.io[offset] = value
        if offset >= audio::REGISTER_BASE && offset < audio::REGISTER_END {
            memory.audio_events.push(audio_event(1, offset, u32.from(value)))
        }
    }

    fn write_keypad8(memory: write State, offset: usize, value: u8) -> void {
        if offset < keypad::CONTROL {
            return
        }
        var control = memory.keypad_control & 65280 | u16.from(value)
        if offset == keypad::CONTROL + 1 {
            control = memory.keypad_control & 255 | u16.from(value) << 8
        }
        keypad::write_control(memory, control)
    }

    fn system_offset(offset: usize) -> bool {
        (offset >= system::INTERRUPT_ENABLE && offset <= system::WAIT_CONTROL + 1) ||(offset >= system::INTERRUPT_MASTER && offset <= system::INTERRUPT_MASTER + 1)
    }

    fn write_system16(memory: write State, address: u32, value: u16) -> bool {
        if address == memory::io_address(system::INTERRUPT_ENABLE) {
            io_store16(memory, system::INTERRUPT_ENABLE, value & system::INTERRUPT_MASK)
            return true
        }
        if address == memory::io_address(system::INTERRUPT_FLAGS) {
            let current = io_read16(memory, system::INTERRUPT_FLAGS)
            io_store16(memory, system::INTERRUPT_FLAGS, current & ~value)
            return true
        }
        if address == memory::io_address(system::WAIT_CONTROL) {
            io_store16(memory, system::WAIT_CONTROL, value & system::WAIT_CONTROL_MASK)
            return true
        }
        if address == memory::io_address(system::INTERRUPT_MASTER) {
            io_store16(memory, system::INTERRUPT_MASTER, value & 1)
            return true
        }
        false
    }
}
