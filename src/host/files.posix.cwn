module host {
    extern "c" {
        fn open(path: RawPtr<u8>, flags: i32) -> i32 = "open"
        fn seek(file: i32, offset: i64, origin: i32) -> i64 = "lseek"
        fn host_read(file: i32, output: RawPtr<u8>, length: usize) -> isize = "read"
        fn host_write(file: i32, input: RawPtr<u8>, length: usize) -> isize = "write"
        fn close(file: i32) -> i32 = "close"
        fn sync(file: i32) -> i32 = "fsync"
        fn make_temporary(path: RawPtr<u8>) -> i32 = "mkstemp"
        fn rename(source: RawPtr<u8>, destination: RawPtr<u8>) -> i32 = "rename"
        fn unlink(path: RawPtr<u8>) -> i32 = "unlink"
    }

    opaque resource File {
        value: i32
        drop {
            unsafe {
                if value >= 0 {
                    close(value)
                }
            }
        }
    }

    fn read_host_file(file: File, buffer: write Buffer, length: usize) -> bool {
        if length > buffer_length(buffer) {
            return false
        }
        var offset: usize = 0
        while offset < length {
            var count: isize = 0
            unsafe {
                let data = buffer_write_pointer(buffer)
                count = host_read(file.value, data.offset(offset), length - offset)
            }
            if count <= 0 {
                return false
            }
            offset = offset + usize.from(count)
        }
        return true
    }

    fn open_path_file(path: TextView, flags: i32) -> Option<File> {
        let encoded = std::cstr::encode(path)
        match move encoded {
            Some(bytes) => {
                let data = move bytes
                var value: i32 = -1
                unsafe {
                    value = open(data.as_raw(), flags)
                }
                if value < 0 {
                    return None()
                }
                unsafe {
                    return Some(File {
                            value: value
                        })
                }
            }
            None => {
                return None()
            }
        }
    }

    fn open_buffer_file(path: Buffer, flags: i32) -> Option<File> {
        if buffer_is_path(path) == false {
            return None()
        }
        var value: i32 = -1
        unsafe {
            value = open(buffer_read_pointer(path), flags)
        }
        if value < 0 {
            return None()
        }
        unsafe {
            return Some(File {
                    value: value
                })
        }
    }

    fn seek_host_file(file: File, offset: i64, origin: i32) -> i64 {
        unsafe {
            return seek(file.value, offset, origin)
        }
    }

    fn close_host_file(file: write File) -> i32 {
        unsafe {
            if file.value < 0 {
                return 0
            }
            let value = file.value
            file.value = -1
            return close(value)
        }
    }

    fn sync_host_file(file: File) -> i32 {
        unsafe {
            return sync(file.value)
        }
    }

    fn make_temporary_file(path: write Buffer) -> Option<File> {
        if buffer_is_path(path) == false {
            return None()
        }
        var value: i32 = -1
        unsafe {
            value = make_temporary(buffer_write_pointer(path))
        }
        if value < 0 {
            return None()
        }
        unsafe {
            return Some(File {
                    value: value
                })
        }
    }

    fn rename_host_file(source: Buffer, destination: Buffer) -> i32 {
        if buffer_is_path(source) == false {
            return -1
        }
        if buffer_is_path(destination) == false {
            return -1
        }
        unsafe {
            return rename(buffer_read_pointer(source), buffer_read_pointer(destination))
        }
    }

    fn unlink_host_file(path: Buffer) -> i32 {
        if buffer_is_path(path) == false {
            return -1
        }
        unsafe {
            return unlink(buffer_read_pointer(path))
        }
    }

    fn write_host_buffer(file: File, buffer: Buffer, length: usize) -> bool {
        if length > buffer_length(buffer) {
            return false
        }
        unsafe {
            return write_raw_descriptor(file.value, buffer, length)
        }
    }

    unsafe fn write_raw_descriptor(file: i32, buffer: Buffer, length: usize) -> bool {
        var offset: usize = 0
        while offset < length {
            var count: isize = 0
            unsafe {
                let data = buffer_read_pointer(buffer)
                count = host_write(file, data.offset(offset), length - offset)
            }
            if count <= 0 {
                return false
            }
            offset = offset + usize.from(count)
        }
        return true
    }

    fn write_standard_error(buffer: Buffer, length: usize) -> bool {
        if length > buffer_length(buffer) {
            return false
        }
        unsafe {
            return write_raw_descriptor(2, buffer, length)
        }
    }

    fn path_separator(value: u8) -> bool {
        return value == 47
    }
}
