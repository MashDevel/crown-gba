module screenshot {
    const FILE_HEADER_BYTES: usize = 14
    const INFO_HEADER_BYTES: usize = 40
    const HEADER_BYTES: usize = FILE_HEADER_BYTES + INFO_HEADER_BYTES
    const BYTES_PER_PIXEL: usize = 3
    const ROW_BYTES: usize = (video::WIDTH * BYTES_PER_PIXEL + 3) / 4 * 4
    const PIXEL_BYTES: usize = ROW_BYTES * video::HEIGHT
    const FILE_BYTES: usize = HEADER_BYTES + PIXEL_BYTES
    const SIGNATURE: u16 = 0x4d42
    const FILE_SIZE_OFFSET: usize = 2
    const PIXEL_DATA_OFFSET: usize = 10
    const WIDTH_OFFSET: usize = FILE_HEADER_BYTES + 4
    const HEIGHT_OFFSET: usize = FILE_HEADER_BYTES + 8
    const PLANES_OFFSET: usize = FILE_HEADER_BYTES + 12
    const BIT_DEPTH_OFFSET: usize = FILE_HEADER_BYTES + 14
    const PIXEL_BYTES_OFFSET: usize = FILE_HEADER_BYTES + 20
    const HORIZONTAL_DENSITY_OFFSET: usize = FILE_HEADER_BYTES + 24
    const VERTICAL_DENSITY_OFFSET: usize = FILE_HEADER_BYTES + 28
    const PIXELS_PER_METER: u32 = 2835
    const OPEN_ERROR: u32 = 61
    const WRITE_ERROR: u32 = 62
    const CLOSE_ERROR: u32 = 63

    fn save_frame_bmp(path: TextView, ppu: video::State) -> u32 {
        let created = host::allocate_buffer(FILE_BYTES)
        match move created {
            Ok(buffer) => {
                var image = move buffer
                write_bmp_header(image)
                write_bmp_pixels(image, ppu)
                return write_bmp_file(path, image)
            }
            Err(code) => {
                return code
            }
        }
    }

    fn write_bmp_header(buffer: write host::Buffer) -> void {
        var index: usize = 0
        while index < HEADER_BYTES {
            host::buffer_set(buffer, index, 0)
            index = index + 1
        }
        write_buffer_u16(buffer, 0, SIGNATURE)
        write_buffer_u32(buffer, FILE_SIZE_OFFSET, u32.from(FILE_BYTES))
        write_buffer_u32(buffer, PIXEL_DATA_OFFSET, u32.from(HEADER_BYTES))
        write_buffer_u32(buffer, FILE_HEADER_BYTES, u32.from(INFO_HEADER_BYTES))
        write_buffer_u32(buffer, WIDTH_OFFSET, u32.from(video::WIDTH))
        write_buffer_u32(buffer, HEIGHT_OFFSET, u32.from(video::HEIGHT))
        write_buffer_u16(buffer, PLANES_OFFSET, 1)
        write_buffer_u16(buffer, BIT_DEPTH_OFFSET, u16.from(BYTES_PER_PIXEL * 8))
        write_buffer_u32(buffer, PIXEL_BYTES_OFFSET, u32.from(PIXEL_BYTES))
        write_buffer_u32(buffer, HORIZONTAL_DENSITY_OFFSET, PIXELS_PER_METER)
        write_buffer_u32(buffer, VERTICAL_DENSITY_OFFSET, PIXELS_PER_METER)
        return
    }

    fn write_buffer_u16(buffer: write host::Buffer, offset: usize, value: u16) -> void {
        host::buffer_set(buffer, offset, u8.from(value & 255))
        host::buffer_set(buffer, offset + 1, u8.from(value >> 8))
        return
    }

    fn write_buffer_u32(buffer: write host::Buffer, offset: usize, value: u32) -> void {
        host::buffer_set(buffer, offset, bytes::low_u8(value))
        host::buffer_set(buffer, offset + 1, bytes::high_u8(value, 8))
        host::buffer_set(buffer, offset + 2, bytes::high_u8(value, 16))
        host::buffer_set(buffer, offset + 3, bytes::high_u8(value, 24))
        return
    }

    fn write_bmp_pixels(buffer: write host::Buffer, ppu: video::State) -> void {
        var y: usize = 0
        while y < video::HEIGHT {
            var x: usize = 0
            while x < video::WIDTH {
                let color = ppu.framebuffer[(video::HEIGHT - 1 - y) * video::WIDTH + x]
                let offset: usize = HEADER_BYTES + y * ROW_BYTES + x * BYTES_PER_PIXEL
                host::buffer_set(buffer, offset, u8.from(color & 255))
                host::buffer_set(buffer, offset + 1, u8.from(color >> 8 & 255))
                host::buffer_set(buffer, offset + 2, u8.from(color >> 16 & 255))
                x = x + 1
            }
            y = y + 1
        }
        return
    }

    fn write_bmp_file(path: TextView, buffer: host::Buffer) -> u32 {
        match host::write_buffer_file(path, buffer) {
            Ok(value) => {
                value;
                return 0
            }
            Err(error) => {
                return bmp_file_error(error)
            }
        }
    }

    fn bmp_file_error(error: std::io::Error) -> u32 {
        match error {
            Open => {
                return OPEN_ERROR
            }
            InvalidPath => {
                return OPEN_ERROR
            }
            Close => {
                return CLOSE_ERROR
            }
            _ => {
                return WRITE_ERROR
            }
        }
    }
}
