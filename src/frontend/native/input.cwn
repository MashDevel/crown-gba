module app {
    fn key_mask(key: u64) -> u32 {
        let codes: [u64; 10] = [6, 7, 51, 36, 124, 123, 126, 125, 1, 0]
        let masks: [u32; 10] = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512]
        var index: usize = 0
        while index < 10 {
            if codes[index] == key {
                return masks[index]
            }
            index = index + 1
        }
        return 0
    }
}
