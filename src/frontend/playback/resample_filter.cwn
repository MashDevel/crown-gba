module app {
    const FILTER_TAPS: usize = 32
    const FILTER_PHASES: usize = 1024
    const FILTER_PI: f64 = 3.141592653589793

    fn prepare_resampler(ring: write SampleRing, rate: u32) -> void {
        if ring.rate == rate {
            return
        }
        ring.rate = rate
        ring.phase = 0
        ring.cursor = 0
        ring.initialized = false
        ring.kernel = Vec<f64>.new()
        if rate == OUTPUT_RATE {
            return
        }
        var cutoff: f64 = 0.5
        if rate > OUTPUT_RATE {
            cutoff = 0.5 * f64.from(OUTPUT_RATE) / f64.from(rate)
        }
        for phase in 0..FILTER_PHASES {
            let fraction = f64.from(phase) / f64.from(FILTER_PHASES)
            for tap in 0..FILTER_TAPS {
                let distance = fraction -(f64.from(tap) - 15.0)
                ring.kernel.push(resample_weight(distance, cutoff))
            }
        }
    }

    fn resample_weight(distance: f64, cutoff: f64) -> f64 {
        let angle = FILTER_PI * distance / 16.0
        let window = 0.42 + 0.5 * host::native_cos(angle) + 0.08 * host::native_cos(2.0 * angle)
        let argument = 2.0 * cutoff * distance * FILTER_PI
        var sinc: f64 = 1.0
        if argument != 0.0 {
            sinc = host::native_sin(argument) / argument
        }
        return 2.0 * cutoff * sinc * window
    }

    fn retain_source_sample(ring: write SampleRing, current: [i32; 2]) -> void {
        if ring.initialized == false {
            for tap in 0..FILTER_TAPS {
                ring.history[tap * 2] = current[0]
                ring.history[tap * 2 + 1] = current[1]
            }
            ring.initialized = true
        }
        ring.history[ring.cursor * 2] = current[0]
        ring.history[ring.cursor * 2 + 1] = current[1]
        ring.cursor = (ring.cursor + 1) % FILTER_TAPS
    }

    fn filtered_source_sample(ring: SampleRing) -> [f64; 2] {
        var phase = usize.from((ring.phase * u64.from(FILTER_PHASES) + u64.from(OUTPUT_RATE / 2)) / u64.from(OUTPUT_RATE))
        if phase >= FILTER_PHASES {
            phase = FILTER_PHASES - 1
        }
        var sum: [f64; 2] = [0.0, 0.0]
        var weight_sum: f64 = 0.0
        for tap in 0..FILTER_TAPS {
            let position = (ring.cursor + tap) % FILTER_TAPS
            let weight = ring.kernel[phase * FILTER_TAPS + tap]
            sum[0] = sum[0] + f64.from(ring.history[position * 2]) * weight
            sum[1] = sum[1] + f64.from(ring.history[position * 2 + 1]) * weight
            weight_sum = weight_sum + weight
        }
        return [sum[0] / weight_sum, sum[1] / weight_sum]
    }
}
