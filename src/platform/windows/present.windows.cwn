module platform {
    fn present_frame(window: Window, pixels: Vec<u32>) -> u32 {
        if pixels.length() != 38400 {
            return 86
        }
        unsafe {
            if window.handle == 0 {
                return 0
            }
            let minimized = RawPtr<fn(read usize) -> i32>.cast(std::dylib::slot(window.user, 17)).read()
            if minimized(window.handle) != 0 {
                return 0
            }
            var rect: [i32; 4] = [0, 0, 0, 0]
            let client = RawPtr<fn(read usize, read RawPtr<i32>) -> i32>.cast(std::dylib::slot(window.user, 11)).read()
            if client(window.handle, rect.as_raw()) == 0 {
                return 83
            }
            if rect[2] <= 0 || rect[3] <= 0 {
                return 0
            }
            let acquire = RawPtr<fn(read usize) -> usize>.cast(std::dylib::slot(window.user, 12)).read()
            let release = RawPtr<fn(read usize, read usize) -> i32>.cast(std::dylib::slot(window.user, 13)).read()
            let dc = acquire(window.handle)
            if dc == 0 {
                return 84
            }
            let status = draw_frame(window, dc, rect, pixels)
            release(window.handle, dc)
            return status
        }
    }

    fn draw_frame(window: Window, dc: usize, rect: [i32; 4], pixels: Vec<u32>) -> u32 {
        unsafe {
            let fill = RawPtr<fn(read usize, read RawPtr<i32>, read usize) -> i32>.cast(std::dylib::slot(window.user, 16)).read()
            let stock = RawPtr<fn(read i32) -> usize>.cast(std::dylib::slot(window.graphics, 2)).read()
            fill(dc, rect.as_raw(), stock(4))
            let mode = RawPtr<fn(read usize, read i32) -> i32>.cast(std::dylib::slot(window.graphics, 1)).read()
            mode(dc, 3)
            let draw = RawPtr<fn(read usize, read i32, read i32, read i32, read i32, read i32, read i32, read i32, read i32, read RawPtr<u32>, read RawPtr<i32>, read u32, read u32) -> i32>.cast(std::dylib::slot(window.graphics, 0)).read()
            let size = app::windows_image_dimensions(u32.from(rect[2]), u32.from(rect[3]))
            let width = i32.from(size[0])
            let height = i32.from(size[1])
            if width == 0 || height == 0 {
                return 0
            }
            let info: [i32; 10] = [40, 240, -160, 2097153, 0, 153600, 0, 0, 0, 0]
            let result = draw(dc, (rect[2] - width) / 2, (rect[3] - height) / 2, width, height, 0, 0, 240, 160, pixels.as_raw(), info.as_raw(), 0, 13369376)
            return if result == 0 || result == -1 {
                85
            } else {
                0
            }
        }
    }
}
