module platform {
    fn window_user_library() -> Result<std::dylib::Library, u32> {
        return win::library("user32.dll", "RegisterClassExW|CreateWindowExW|UnregisterClassW|DestroyWindow|DefWindowProcW|LoadCursorW|PeekMessageW|TranslateMessage|DispatchMessageW|IsWindow|GetForegroundWindow|GetClientRect|GetDC|ReleaseDC|ShowWindow|AdjustWindowRect|FillRect|IsIconic|InvalidateRect|UpdateWindow|BeginPaint|EndPaint")
    }

    fn window_graphics_library() -> Result<std::dylib::Library, u32> {
        return win::library("gdi32.dll", "StretchDIBits|SetStretchBltMode|GetStockObject|CreateCompatibleDC|CreateCompatibleBitmap|SelectObject|DeleteObject|DeleteDC|BitBlt")
    }
}
