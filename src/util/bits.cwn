module bits {
    fn bit_u32(value: u32, index: u32) -> bool {
        return value &(1 << index) != 0
    }

    fn bit_u16(value: u16, index: usize) -> bool {
        return value &(1 << u16.from(index)) != 0
    }

    fn bool_u32(value: bool) -> u32 {
        if value {
            return 1
        }
        return 0
    }

    fn u32(value: u32, shift: u32, width: u32) -> u32 {
        if width == 32 {
            return value >> shift
        }
        return value >> shift &((1 << width) - 1)
    }

    fn rotate_right_u32(value: u32, amount: u32) -> u32 {
        let masked = amount & 31
        if masked == 0 {
            return value
        }
        return value >> masked | value <<(32 - masked)
    }

    fn sign_extend_u32(value: u32, width: u32) -> u32 {
        if width == 32 {
            return value
        }
        let total: u32 = 32
        let shift = total.wrapping_sub(width)
        let amount = i32.from_bits(shift)
        let signed = i32.from_bits(value << shift) >> amount
        return u32.from_bits(signed)
    }

    fn add_overflow_u32(left: u32, right: u32, result: u32) -> bool {
        return (~(left ^ right) &(left ^ result) & 2147483648) != 0
    }

    fn sub_overflow_u32(left: u32, right: u32, result: u32) -> bool {
        return ((left ^ right) &(left ^ result) & 2147483648) != 0
    }

    fn count_bits_u16(value: u16) -> u32 {
        var remaining = value
        var count: u32 = 0
        while remaining != 0 {
            count = count + u32.from(remaining & 1)
            remaining = remaining >> 1
        }
        return count
    }
}
