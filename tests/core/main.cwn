fn run_dma_tests(emulator: write emulator::State) -> u32 {
    let registers = test_dma_registers(emulator);
    if registers != 0 {
        return registers
    }
    let timing = test_dma_timing_masks(emulator);
    if timing != 0 {
        return timing
    }
    let quiet = test_quiet_device_advance(emulator);
    if quiet != 0 {
        return quiet
    }
    let audio = test_pending_audio_device_advance(emulator);
    if audio != 0 {
        return audio
    }
    let halted = test_halted_device_advance(emulator);
    if halted != 0 {
        return halted
    }
    let blocked = test_hblank_dma_block(emulator);
    if blocked != 0 {
        return blocked
    }
    let elapsed = test_dma_elapsed_cycles(emulator);
    if elapsed != 0 {
        return elapsed
    }
    return test_display_timing(emulator)
}

fn run_frontend_tests(emulator: write emulator::State) -> u32 {
    let cases = [test_windows_frontend, test_save_paths, test_linux_frontend, test_native_input, test_native_frontend_state]
    for index in 0..5 {
        let check = cases[index]
        let result = check()
        if result != 0 {
            return result
        }
    }
    let channels = test_audio_channels()
    if channels != 0 {
        return channels
    }
    return test_audio_integrity(emulator)
}

fn run_loaded_tests(arguments: read Arguments, emulator: write emulator::State) -> u32 {
    let frontend = run_frontend_tests(emulator)
    if frontend != 0 {
        return frontend
    }
    let bios = run_bios_tests(emulator);
    if bios != 0 {
        return bios
    }
    let core = run_cpu_bus_tests(arguments[1], emulator);
    if core != 0 {
        return core
    }
    let instructions = test_cpu_instructions(emulator)
    if instructions != 0 {
        return instructions
    }
    let storage = run_storage_audio_tests(arguments[2], emulator)
    if storage != 0 {
        return storage
    }
    let ppu = run_ppu_tests(emulator);
    if ppu != 0 {
        return ppu
    }
    return run_dma_tests(emulator)
}

fn run_tests(arguments: read Arguments) -> u32 {
    if arguments.length() < 3 {
        return 20
    }
    let loaded = cartridge::load(arguments[1])
    match move loaded {
        Ok(cartridge) => {
            var emulator = emulator::new(move cartridge)
            return run_loaded_tests(arguments, emulator)
        }
        Err(code) => {
            return code
        }
    }
}

fn main(arguments: read Arguments) -> u32 {
    return run_tests(arguments)
}
