fn test_mixer_edges(emulator: write emulator::State) -> u32 {
    let result = mixer_tests::run(emulator)
    bios::hard_reset(emulator)
    return match result {
        Ok(value) => {
            value;
            0
        }
        Err(code) => code
    }
}

module mixer_tests {
    fn run(emulator: write emulator::State) -> Result<void, u32> {
        var state = audio::new()
        state.fifo_a.current_sample = 10
        state.fifo_b.current_sample = -20
        let controls: [u16; 4] = [0, 0x3300, 0x330c, 0x120c]
        let expected_left: [i32; 4] = [0, -20, -40, 40]
        let expected_right: [i32; 4] = [0, -20, -40, -80]
        for index in 0..4 {
            let sample = audio::mix_pcm(state, controls[index])
            assertions::equal(u32.from_bits(sample[0]), u32.from_bits(expected_left[index]), 1400)?
            assertions::equal(u32.from_bits(sample[1]), u32.from_bits(expected_right[index]), 1401)?
        }
        audio::write_master(state, 128)
        audio::write16(state, audio::DIRECT_CONTROL, 1)
        let silent = audio::mix_sample(state)
        assertions::equal(u32.from_bits(silent[0]), 0, 1402)?
        return requests(emulator)
    }

    fn requests(emulator: write emulator::State) -> Result<void, u32> {
        bios::hard_reset(emulator)
        dma_tests::setup(emulator, 1, 0, 4)
        let offset = dma::BASE + dma::STRIDE
        memory::io_store32(emulator.memory, offset + dma::DESTINATION, memory::io_address(audio::FIFO_A))
        audio::request_dma(emulator, 0)
        assertions::equal(u32.from(emulator.memory.audio_events.length()), 0, 1403)?
        memory::io_store16(emulator.memory, offset + dma::CONTROL, 0x8000)
        audio::request_dma(emulator, 0)
        assertions::equal(u32.from(emulator.memory.audio_events.length()), 0, 1404)?
        memory::io_store16(emulator.memory, offset + dma::CONTROL, 0xb640)
        audio::request_dma(emulator, 0)
        audio::process_events(emulator)
        assertions::equal(u32.from(emulator.audio.fifo_a.length), 16, 1405)?
        for index in 0..32 {
            index;
            audio::fifo_push(emulator.audio.fifo_b, 1)
        }
        audio::handle_timer_overflow(emulator, 0, 0)
        assertions::equal(u32.from(emulator.audio.fifo_a.length), 12, 1406)?
        assertions::equal(u32.from(emulator.audio.fifo_b.length), 28, 1407)?
        audio::handle_timer_overflow(emulator, 2, 0)
        return assertions::equal(u32.from(emulator.audio.fifo_b.length), 28, 1408)
    }
}
