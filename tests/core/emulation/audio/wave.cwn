module channel_tests {
    fn waves() -> Result<void, u32> {
        var wave = audio::new_wave_channel()
        let registers = std::bytes::filled(audio::REGISTER_SIZE, 0xf8)
        audio::wave_step(wave, 16)
        assertions::equal(u32.from_bits(audio::wave_sample(wave, registers)), 0, 948)?
        audio::wave_set_control(wave, 0x80)
        audio::wave_set_frequency(wave, 0x87ff)
        let expected: [i32; 10] = [-15, -15, 15, 1, -1, -7, -9, -11, 7, -3]
        for index in 0..10 {
            let volume = u16.from(index / 2)
            audio::wave_set_length(wave, if volume == 4 {
                    0x8000
                } else {
                    volume << 13
                })
            wave.index = index % 2
            assertions::equal(u32.from_bits(audio::wave_sample(wave, registers)), u32.from_bits(expected[index]), 949)?
        }
        wave.index = 31
        audio::wave_step(wave, 8)
        return assertions::equal(u32.from(wave.index), 0, 950)
    }
}
