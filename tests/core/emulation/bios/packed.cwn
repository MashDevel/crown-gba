module stream_tests {
    fn unpack(emulator: write emulator::State) -> Result<void, u32> {
        let widths: [u32; 5] = [0x0100, 0x0001, 0x0809, 0x2101, 0x2020]
        let info = SOURCE + 64
        for index in 0..5 {
            prepare(emulator, 1)
            emulator.cpu.registers[2] = info
            memory::write32(emulator.memory, info, widths[index] << 16 | 2)
            memory::write32(emulator.memory, info + 4, 0)
            bios::handle_swi(emulator, bios::call::BIT_UNPACK)
            assertions::equal(memory::read32(emulator.memory, emulator.cartridge, OUTPUT), 0xcccccccc, 1280)?
        }
        prepare(emulator, 1)
        memory::write32(emulator.memory, info, 0x08040002)
        memory::write32(emulator.memory, info + 4, 0x80000005)
        bios::handle_swi(emulator, bios::call::BIT_UNPACK)
        return assertions::equal(memory::read32(emulator.memory, emulator.cartridge, OUTPUT), 0x05050506, 1281)
    }

    fn packed_tree(emulator: write emulator::State) -> Result<void, u32> {
        let headers: [u32; 2] = [0x10, 0x20]
        for index in 0..2 {
            prepare(emulator, headers[index])
            bios::handle_swi(emulator, bios::call::HUFFMAN)
            assertions::equal(memory::read32(emulator.memory, emulator.cartridge, OUTPUT), 0xcccccccc, 1282)?
        }
        prepare(emulator, 0x224)
        memory::write32(emulator.memory, SOURCE + 4, 0xc1018003)
        memory::write32(emulator.memory, SOURCE + 8, 0x03020000)
        memory::write32(emulator.memory, SOURCE + 12, 0x9c000000)
        bios::handle_swi(emulator, bios::call::HUFFMAN)
        return assertions::equal(memory::read32(emulator.memory, emulator.cartridge, OUTPUT), 0x2312, 1283)
    }
}
