fn test_bios_math(emulator: write emulator::State) -> u32 {
    return match bios_math_tests::run(emulator) {
        Ok(value) => {
            value;
            0
        }
        Err(code) => code
    }
}

module bios_math_tests {
    fn run(emulator: write emulator::State) -> Result<void, u32> {
        division(emulator)?
        square_roots(emulator)?
        return angles(emulator)
    }

    fn division(emulator: write emulator::State) -> Result<void, u32> {
        let numerators: [u32; 7] = [10, 0xfffffff6, 10, 0x80000000, 0x80000000, 5, 0xfffffffb]
        let denominators: [u32; 7] = [3, 3, 0xfffffffd, 0xffffffff, 2, 0, 0]
        let quotients: [u32; 7] = [3, 0xfffffffd, 0xfffffffd, 0x80000000, 0xc0000000, 0x7fffffff, 0x80000000]
        let remainders: [u32; 7] = [1, 0xffffffff, 1, 0, 0, 5, 0xfffffffb]
        let magnitudes: [u32; 7] = [3, 3, 3, 0x80000000, 0x40000000, 1, 1]
        for index in 0..14 {
            let test = index % 7
            let reversed = index >= 7
            emulator.cpu.registers[0] = if reversed {
                denominators[test]
            } else {
                numerators[test]
            }
            emulator.cpu.registers[1] = if reversed {
                numerators[test]
            } else {
                denominators[test]
            }
            bios::handle_swi(emulator, if reversed {
                    bios::call::DIVIDE_ARM
                } else {
                    bios::call::DIVIDE
                })
            assertions::equal(emulator.cpu.registers[0], quotients[test], 1040)?
            assertions::equal(emulator.cpu.registers[1], remainders[test], 1041)?
            assertions::equal(emulator.cpu.registers[3], magnitudes[test], 1042)?
        }
        return Ok(())
    }

    fn square_roots(emulator: write emulator::State) -> Result<void, u32> {
        let inputs: [u32; 8] = [0, 1, 2, 3, 4, 15, 16, 0xffffffff]
        let expected: [u32; 8] = [0, 1, 1, 1, 2, 3, 4, 65535]
        for index in 0..8 {
            emulator.cpu.registers[0] = inputs[index]
            bios::handle_swi(emulator, bios::call::SQUARE_ROOT)
            assertions::equal(emulator.cpu.registers[0], expected[index], 1043)?
        }
        return Ok(())
    }

    fn angles(emulator: write emulator::State) -> Result<void, u32> {
        let inputs: [u32; 3] = [0, 256, 0xff00]
        let expected: [u32; 3] = [0, 8192, 57344]
        for index in 0..3 {
            emulator.cpu.registers[0] = inputs[index]
            bios::handle_swi(emulator, bios::call::ARCTANGENT)
            assertions::equal(emulator.cpu.registers[0], expected[index], 1044)?
        }
        let x: [u32; 4] = [256, 0, 0xff00, 0]
        let y: [u32; 4] = [0, 256, 0, 0xff00]
        for index in 0..4 {
            emulator.cpu.registers[0] = x[index]
            emulator.cpu.registers[1] = y[index]
            bios::handle_swi(emulator, bios::call::ARCTANGENT_2)
            assertions::equal(emulator.cpu.registers[0], u32.from(index) * 16384, 1045)?
        }
        return Ok(())
    }
}
