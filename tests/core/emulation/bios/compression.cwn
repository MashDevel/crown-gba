fn test_vram_compression(emulator: write emulator::State) -> u32 {
    let source: u32 = 33557248
    let output: u32 = 100663296
    memory::write32(emulator.memory, source, 816)
    memory::write8(emulator.memory, source.wrapping_add(4), 130)
    memory::write8(emulator.memory, source.wrapping_add(5), 122)
    memory::write16(emulator.memory, output.wrapping_add(2), 52445)
    emulator.cpu.registers[0] = source
    emulator.cpu.registers[1] = output
    bios::run_length(emulator, true)
    if memory::read16(emulator.memory, emulator.cartridge, output) != 31354 {
        return 43
    }
    if memory::read16(emulator.memory, emulator.cartridge, output.wrapping_add(2)) != 52346 {
        return 44
    }
    return 0
}

fn test_compression_header(emulator: write emulator::State) -> u32 {
    let source: u32 = 33557504
    let output: u32 = 33557760
    memory::write32(emulator.memory, source, 1177)
    memory::write32(emulator.memory, output, 3735928559)
    emulator.cpu.registers[0] = source
    emulator.cpu.registers[1] = output
    bios::lz77(emulator, false)
    if memory::read32(emulator.memory, emulator.cartridge, output) != 3735928559 {
        return 45
    }
    bios::run_length(emulator, false)
    if memory::read32(emulator.memory, emulator.cartridge, output) != 3735928559 {
        return 46
    }
    bios::diff8(emulator, false)
    if memory::read32(emulator.memory, emulator.cartridge, output) != 3735928559 {
        return 47
    }
    return 0
}

fn test_compression_edges(emulator: write emulator::State) -> u32 {
    let vram = test_vram_compression(emulator)
    if vram != 0 {
        return vram
    }
    return test_compression_header(emulator)
}

fn test_lz77(emulator: write emulator::State) -> u32 {
    let source: u32 = 33554432
    let output: u32 = 33554688
    memory::write32(emulator.memory, source, 784)
    memory::write8(emulator.memory, source.wrapping_add(4), 0)
    memory::write8(emulator.memory, source.wrapping_add(5), 65)
    memory::write8(emulator.memory, source.wrapping_add(6), 66)
    memory::write8(emulator.memory, source.wrapping_add(7), 67)
    emulator.cpu.registers[0] = source
    emulator.cpu.registers[1] = output
    bios::lz77(emulator, false)
    if memory::read8(emulator.memory, emulator.cartridge, output) != 65 {
        return 1
    }
    if memory::read8(emulator.memory, emulator.cartridge, output.wrapping_add(1)) != 66 {
        return 2
    }
    if memory::read8(emulator.memory, emulator.cartridge, output.wrapping_add(2)) != 67 {
        return 3
    }
    return 0
}

fn test_run_length(emulator: write emulator::State) -> u32 {
    let source: u32 = 33554944
    let output: u32 = 33555200
    memory::write32(emulator.memory, source, 1328)
    memory::write8(emulator.memory, source.wrapping_add(4), 130)
    memory::write8(emulator.memory, source.wrapping_add(5), 7)
    emulator.cpu.registers[0] = source
    emulator.cpu.registers[1] = output
    bios::run_length(emulator, false)
    var index: u32 = 0
    while index < 5 {
        if memory::read8(emulator.memory, emulator.cartridge, output.wrapping_add(index)) != 7 {
            return 4
        }
        index = index + 1
    }
    return 0
}

fn test_diff(emulator: write emulator::State) -> u32 {
    let source: u32 = 33555456
    let output: u32 = 33555712
    memory::write32(emulator.memory, source, 896)
    memory::write8(emulator.memory, source.wrapping_add(4), 1)
    memory::write8(emulator.memory, source.wrapping_add(5), 2)
    memory::write8(emulator.memory, source.wrapping_add(6), 3)
    emulator.cpu.registers[0] = source
    emulator.cpu.registers[1] = output
    bios::diff8(emulator, false)
    if memory::read8(emulator.memory, emulator.cartridge, output) != 1 {
        return 5
    }
    if memory::read8(emulator.memory, emulator.cartridge, output.wrapping_add(1)) != 3 {
        return 6
    }
    if memory::read8(emulator.memory, emulator.cartridge, output.wrapping_add(2)) != 6 {
        return 7
    }
    return 0
}

fn test_huffman(emulator: write emulator::State) -> u32 {
    let source: u32 = 33555968
    let output: u32 = 33556224
    memory::write32(emulator.memory, source, 1064)
    memory::write8(emulator.memory, source.wrapping_add(4), 1)
    memory::write8(emulator.memory, source.wrapping_add(5), 192)
    memory::write8(emulator.memory, source.wrapping_add(6), 65)
    memory::write8(emulator.memory, source.wrapping_add(7), 66)
    memory::write32(emulator.memory, source.wrapping_add(8), 1426063360)
    emulator.cpu.registers[0] = source
    emulator.cpu.registers[1] = output
    bios::huffman(emulator)
    if memory::read32(emulator.memory, emulator.cartridge, output) != 1111573057 {
        return 25
    }
    return 0
}

fn test_bit_unpack(emulator: write emulator::State) -> u32 {
    let source: u32 = 33556480
    let info: u32 = 33556736
    let output: u32 = 33556992
    memory::write8(emulator.memory, source, 165)
    memory::write16(emulator.memory, info, 1)
    memory::write8(emulator.memory, info.wrapping_add(2), 1)
    memory::write8(emulator.memory, info.wrapping_add(3), 4)
    memory::write32(emulator.memory, info.wrapping_add(4), 1)
    emulator.cpu.registers[0] = source
    emulator.cpu.registers[1] = output
    emulator.cpu.registers[2] = info
    bios::bit_unpack(emulator)
    if memory::read32(emulator.memory, emulator.cartridge, output) != 538968578 {
        return 26
    }
    return 0
}
