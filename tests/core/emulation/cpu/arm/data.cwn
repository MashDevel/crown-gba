module instruction_tests {
    fn arm_alu(emulator: write emulator::State) -> Result<void, u32> {
        let expected: [u32; 16] = [2, 5, 3, 0xfffffffd, 9, 10, 3, 0xfffffffd, 99, 99, 99, 99, 7, 3, 4, 0xfffffffc]
        for operation in 0..16 {
            emulator.cpu = cpu::new()
            emulator.cpu.registers[0] = 6
            emulator.cpu.registers[1] = 3
            emulator.cpu.registers[2] = 99
            cpu::set_flag(emulator.cpu, cpu::CARRY, true)
            assertions::equal(cpu::arm::execute_arm(emulator, 0xe0102001 | u32.from(operation) << 21), 1, 960)?
            assertions::equal(emulator.cpu.registers[2], expected[operation], 961 + u32.from(operation))?
        }
        return arm_reverse_borrow(emulator)
    }

    fn arm_reverse_borrow(emulator: write emulator::State) -> Result<void, u32> {
        let left: [u32; 4] = [0, 1, 0xffffffff, 0xffffffff]
        let right: [u32; 4] = [0, 0x80000000, 0x7fffffff, 0x7fffffff]
        let carry: [bool; 4] = [false, true, false, true]
        let expected: [u32; 4] = [0xffffffff, 0x7fffffff, 0x7fffffff, 0x80000000]
        for index in 0..4 {
            emulator.cpu = cpu::new()
            emulator.cpu.registers[0] = left[index]
            emulator.cpu.registers[1] = right[index]
            cpu::set_flag(emulator.cpu, cpu::CARRY, carry[index])
            assertions::equal(cpu::arm::execute_arm(emulator, 0xe0f02001), 1, 978)?
            assertions::equal(emulator.cpu.registers[2], expected[index], 979)?
            assertions::equal(bits::bool_u32(cpu::flag(emulator.cpu, cpu::CARRY)), bits::bool_u32(index == 1), 980)?
            assertions::equal(bits::bool_u32(cpu::flag(emulator.cpu, cpu::OVERFLOW)), bits::bool_u32(index % 2 == 1), 981)?
        }
        return Ok(())
    }
}
