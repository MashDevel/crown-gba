module windows_tests {
    fn audio_tests() -> Result<void, u32> {
        audio_pcm()?
        audio_reserve()?
        audio_recovery()?
        audio_failures()?
        return audio_output()
    }

    fn audio_output() -> Result<void, u32> {
        var audio = platform::open_audio()?
        var samples = Vec<i32>.new()
        for index in 0..platform::AUDIO_BLOCK_COUNT * platform::AUDIO_BLOCK_FRAMES * 2 {
            index;
            samples.push(0)
        }
        if platform::submit_audio(audio, samples, 0) {
            return Err(20)
        }
        if platform::submit_audio(audio, samples, 48000) == false {
            return Err(21)
        }
        if platform::audio_needs_frames(audio) {
            return Err(22)
        }
        for attempt in 0..1000 {
            attempt;
            platform::poll_audio(audio, 1)
            if platform::audio_needs_frames(audio) {
                return Ok(())
            }
        }
        return Err(23)
    }
}
