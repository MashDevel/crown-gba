set -euo pipefail
export XDG_RUNTIME_DIR="$PWD/target/ci/runtime"
export XDG_CONFIG_HOME="$PWD/target/ci/config"
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME/pipewire/pipewire.conf.d" "$XDG_CONFIG_HOME/pipewire/client.conf.d"
chmod 700 "$XDG_RUNTIME_DIR"
cp tests/ci/pipewire-sink.conf "$XDG_CONFIG_HOME/pipewire/pipewire.conf.d/crown.conf"
cp tests/ci/pipewire-client.conf "$XDG_CONFIG_HOME/pipewire/client.conf.d/crown.conf"
pipewire > target/ci/pipewire.log 2>&1 &
server=$!
linker=""
cleanup() {
    if [ -n "$linker" ]; then kill "$linker" 2>/dev/null || true; fi
    kill "$server" 2>/dev/null || true
    wait "$server" 2>/dev/null || true
}
trap cleanup EXIT
for attempt in {1..100}; do
    if pw-cli info 0 > /dev/null 2>&1; then break; fi
    kill -0 "$server"
    sleep 0.1
done
pw-cli info 0 > target/ci/pipewire-info.log
connect_audio() {
    until pw-link -o | grep -Fxq 'crown-ci-playback:output_FL'; do sleep 0.1; done
    pw-link crown-ci-playback:output_FL crown-ci-sink:playback_FL
    pw-link crown-ci-playback:output_FR crown-ci-sink:playback_FR
    pw-link -l
}
connect_audio > target/ci/pipewire-links.log 2>&1 &
linker=$!
xvfb-run -a -s '-screen 0 1280x720x24' "$@"
